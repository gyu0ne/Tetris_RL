{
  "schema_version": "solo-imitation-experiment-v1",
  "purpose": "final long-run solo bootstrap checkpoint before versus reinforcement learning",
  "mechanics_status": "OBSERVED_NOT_FUNCTIONALLY_VERIFIED",
  "generation": {
    "base_seed": 10001,
    "seed_stride": 104729,
    "matches": 4096,
    "decisions_per_match": 250,
    "target_decisions": 1024000,
    "minimum_accepted_decisions": 1000000,
    "fallback_matches": 4224,
    "records": "datasets/solo-imitation-bootstrap-v1/records.jsonl.gz",
    "manifest": "datasets/solo-imitation-bootstrap-v1/manifest.json",
    "engine_revision": "clean committed Git revision required"
  },
  "training": {
    "model": "afterstate-scorer-v1",
    "hidden": [64, 32],
    "initialization_seeds": [2026, 2027, 2028],
    "max_epochs": 100,
    "min_epochs": 20,
    "patience": 10,
    "minimum_regret_improvement": 0.1,
    "shuffle_buffer": 4096,
    "batch_decisions": 64,
    "learning_rate": 0.0003,
    "teacher_temperature": 1.0,
    "teacher_score_scale": 1000.0,
    "threads": 2,
    "candidate_pattern": "checkpoints/solo-imitation-bootstrap-r{round}/seed-{seed}.pt",
    "selected_output": "checkpoints/solo-imitation-bootstrap-r{round}/selected.pt"
  },
  "evaluation": {
    "offline": "python -m tetris_rl.evaluation.offline",
    "closed_loop": "python -m tetris_rl.evaluation.closed_loop",
    "candidate_selection": "python -m tetris_rl.evaluation.select",
    "promotion": "python -m tetris_rl.evaluation.promote",
    "threshold_config": "configs/evaluation/solo_imitation_promotion_v1.json"
  },
  "learner_state_aggregation": {
    "command": "python -m tetris_rl.training.aggregate",
    "run_when_final_survival_has_any_topout": true,
    "rounds_maximum": 2,
    "matches_per_round": 1024,
    "decisions_per_match": 250,
    "target_decisions_per_round": 250000,
    "parallel_games": 128,
    "retrain_from_scratch_after_each_round": true
  },
  "retention": {
    "keep": ["checkpoints/solo-imitation-versus-bootstrap-v1/model.pt"],
    "delete_after_promotion_and_reload": [
      "records",
      "manifest",
      "bootstrap checkpoint",
      "external evaluation reports"
    ]
  }
}
