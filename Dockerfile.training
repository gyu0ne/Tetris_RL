FROM rust:1.89.0-slim-bookworm AS bridge-builder

WORKDIR /workspace
COPY . .

ENV CARGO_TARGET_DIR=/tmp/tetris-target \
    PYO3_BUILD_EXTENSION_MODULE=1 \
    PYO3_NO_PYTHON=1

RUN cargo build --release -p py-bridge --features python-extension

FROM python:3.13.7-slim-bookworm

COPY python/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements.lock

COPY --from=bridge-builder /tmp/tetris-target/release/libtetris_engine.so /usr/local/lib/python3.13/site-packages/tetris_engine.so

WORKDIR /workspace
COPY . .

ENV PYTHONPATH=/workspace/python \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

CMD ["python", "-m", "unittest", "discover", "-s", "python/tests", "-v"]
